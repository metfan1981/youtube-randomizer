[Unit]
Description=YouTube channel randomizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=youtube-randomizer
WorkingDirectory=/
EnvironmentFile=/etc/youtube-randomizer.env
ExecStart=/usr/local/bin/youtube-randomizer
Restart=on-failure
RestartSec=3

# Sandboxing (comment out MemoryDenyWriteExecute if the binary fails to start).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
