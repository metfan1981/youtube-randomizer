# Copy to .env and fill in. Shell-exported vars override these.
# Under systemd, use /etc/youtube-randomizer.env instead.
# Syntax: KEY=value, full-line # comments only, optional "double" or 'single' quotes.

YT_API_KEY=replace-with-your-youtube-data-api-key

HOST=127.0.0.1
PORT=8080
CACHE_TTL=1h
FETCH_TIMEOUT=3m
