# Example environment for local development.
#
#   cp .env.example .env
#
# Edit .env with your real API key and preferences. .env is gitignored.
#
# Precedence:
#   - Values already set in your shell are NOT overwritten by this file.
#   - Under systemd, the repo .env is not used; use EnvironmentFile= (see systemd/README.md).
#
# Supported syntax (minimal parser — not full docker/dotenv):
#   - KEY=value (one per line)
#   - Optional leading "export " (shell-style)
#   - Optional double quotes: KEY="value"  or  single quotes: KEY='value'
#   - Comments: full lines starting with # only (no inline KEY=val # comment)
#   - No backslash escapes inside quoted values

# Required — https://developers.google.com/youtube/v3/getting-started
YT_API_KEY=replace-with-your-youtube-data-api-key

# Listen address (optional). Same as -host; default 127.0.0.1 if unset everywhere.
HOST=127.0.0.1

# Listen port (optional). Same as -port when -port is omitted; else default 8080.
PORT=8080

# Upload list cache TTL (optional)
CACHE_TTL=1h

# Max time to paginate the full uploads list on cache miss (optional)
FETCH_TIMEOUT=3m
